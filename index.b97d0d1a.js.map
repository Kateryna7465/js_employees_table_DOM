        var rowsArray = Array.from(rows);
        rowsArray.sort(function(a, b) {
            var aText = a.querySelectorAll("td")[index].textContent;
            var bText = b.querySelectorAll("td")[index].textContent;
            var comparison;
            if (index === 3 || index === 4) {
                var aValue = Number(aText.replace("$", "").replace(",", ""));
                var bValue = Number(bText.replace("$", "").replace(",", ""));
                comparison = aValue - bValue;
            } else comparison = aText.localeCompare(bText);
            if (sortDirection === "desc") comparison = comparison * -1;
            return comparison;
        });
        var tBody = document.querySelector("tbody");
        rowsArray.forEach(function(row) {
